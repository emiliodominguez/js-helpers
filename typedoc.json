{
	"$schema": "https://typedoc.org/schema.json",
	"name": "js-helpers",
	"entryPoints": ["src/arrays", "src/async", "src/date", "src/decorators", "src/functions", "src/guards", "src/math", "src/objects", "src/strings", "src/utils"],
