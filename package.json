{
	"name": "js-helpers",
	"version": "2.0.0",
	"description": "Strictly-typed, zero-dependency, tree-shakeable TypeScript utilities for arrays, objects, strings, math, functions, async flows, dates, type guards and decorators — property-tested with fast-check.",
	"keywords": [
		"typescript",
		"utilities",
		"helpers",
		"utils",
		"lodash-alternative",
		"functional-programming",
		"type-guards",
		"decorators",
		"debounce",
		"throttle",
		"memoize",
		"deep-clone",
		"deep-merge",
		"string-case",
		"date-utils",
		"async",
		"retry",
		"tree-shakeable",
		"zero-dependencies",
		"property-based-testing"
	],
	"author": "Emilio Dominguez",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/js-helpers.git"
	},
	"bugs": {
		"url": "https://github.com/emiliodominguez/js-helpers/issues"
	},
	"homepage": "https://github.com/emiliodominguez/js-helpers#readme",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		},
		"./*": {
			"import": {
				"types": "./dist/esm/*/index.d.ts",
				"default": "./dist/esm/*/index.js"
			},
			"require": {
				"types": "./dist/cjs/*/index.d.ts",
				"default": "./dist/cjs/*/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "yarn clean && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/finalize-dist.mjs",
		"dev:watch": "tsc -p tsconfig.esm.json -w",
		"typecheck": "tsc --noEmit",
		"prettier": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\"",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint --fix \"src/**/*.ts\"",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"validate": "yarn lint && yarn typecheck && yarn test && yarn build",
		"prepare": "husky",
		"prepublishOnly": "yarn validate",
		"docs": "typedoc"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"eslint --fix",
			"prettier --write"
		]
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.20.5",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.2",
		"eslint-import-resolver-typescript": "^3",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-unused-imports": "^3.2.0",
		"fast-check": "^4.10.2",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^15.5.2",
		"prettier": "^3.9.10",
		"ts-jest": "^29.4.14",
		"typedoc": "^0.28",
		"typescript": "^5.9.3"
	}
}
